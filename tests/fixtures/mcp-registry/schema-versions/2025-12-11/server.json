{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.example/tenant-weather",
  "description": "Weather data for a caller-selected tenant.",
  "version": "1.0.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{tenant}.weather.example.com/mcp",
      "variables": {
        "tenant": {
          "description": "Tenant identifier",
          "isRequired": true
        }
      }
    }
  ]
}
