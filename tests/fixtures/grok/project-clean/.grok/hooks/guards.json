{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/audit-command.sh",
            "timeout": 1.5
          },
          {
            "type": "command",
            "command": "./scripts/deny-secrets.sh",
            "args": ["--strict", "--paths", ".env"],
            "timeout": 2,
            "failClosed": true
          }
        ]
      }
    ],
    "beforeShellExecution": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/note-shell-call.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "make lint",
            "timeout": 600,
            "onFailure": "continue"
          },
          {
            "type": "http",
            "url": "https://hooks.tessellate.example/turn-ended",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
