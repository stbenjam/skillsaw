{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/check-git-push.sh",
            "if": "Bash(git push *)"
          },
          { "type": "command", "command": "./scripts/audit-command.sh" }
        ]
      }
    ]
  }
}
