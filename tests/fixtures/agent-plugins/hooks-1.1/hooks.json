{
  "$schema": "https://agent-plugins.org/schemas/1.1.0/hooks.schema.json",
  "hooks": {
    "SessionStart": [
      {
        "command": "release-review",
        "args": ["--context", "${PLUGIN_ROOT}/review.json"],
        "extensions": {"com.example.review": {"format": "summary"}}
      }
    ],
    "Stop": [{"command": "./bin/finish-review"}]
  }
}
