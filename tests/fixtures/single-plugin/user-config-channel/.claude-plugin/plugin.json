{
  "name": "user-config-channel",
  "version": "1.0.0",
  "description": "Telegram channel whose bot token is declared in the server's channels entry",
  "author": {"name": "Example Maintainers"},
  "mcpServers": {
    "telegram": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server.js"],
      "env": {"TELEGRAM_BOT_TOKEN": "${user_config.bot_token}"}
    }
  },
  "channels": [
    {
      "server": "telegram",
      "displayName": "Telegram",
      "userConfig": {
        "bot_token": {
          "type": "string",
          "title": "Bot token",
          "description": "Token from @BotFather",
          "sensitive": true
        }
      }
    }
  ]
}
